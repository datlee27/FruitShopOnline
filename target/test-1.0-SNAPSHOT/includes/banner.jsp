<%@page contentType="text/html" pageEncoding="UTF-8"%>
<!DOCTYPE html>
<html>
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    <title>JSP Page</title>
    <link rel="stylesheet" href="${pageContext.request.contextPath}/css/main.css">
</head>
<body>
<section class="hero">
    <div class="container">
        <div class="hero-content">
            <div class="hero-text">
                <div class="badge">
                    🌟 100% Fresh & Organic
                </div>
                <h1>
                    Fresh Fruits<br>
                    <span class="highlight">Delivered</span> to<br>
                    Your Door
                </h1>
                <p>
                    Experience the taste of nature with our hand-picked selection of premium fruits. 
                    Farm-fresh quality guaranteed.
                </p>
                <div class="button-group">
                    <a href="#" class="btn btn-primary">
                        Shop Now
                        <span>→</span>
                    </a>
                    <a href="#" class="btn btn-outline">
                        Learn More
                    </a>
                </div>
                <div class="stats">
                    <div class="stat-item">
                        <h3>500+</h3>
                        <p>Happy Customers</p>
                    </div>
                    <div class="stat-item">
                        <h3>50+</h3>
                        <p>Fruit Varieties</p>
                    </div>
                    <div class="stat-item">
                        <h3>24/7</h3>
                        <p>Delivery</p>
                    </div>
                </div>
            </div>

            <div class="hero-image">
                <img src="https://images.unsplash.com/photo-1715941872599-34c3edf7b96f?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&ixid=M3w3Nzg4Nzd8MHwxfHNlYXJjaHwxfHxmcmVzaCUyMGZydWl0JTIwYXNzb3J0bWVudHxlbnwxfHx8fDE3NjEyMzA2OTB8MA&ixlib=rb-4.1.0&q=80&w=1080" alt="Fresh Fruit Assortment">
                <div class="floating-badge">
                    <div class="floating-badge-icon">🎁</div>
                    <div class="floating-badge-text">
                        <h4>Free Delivery</h4>
                        <p>On orders over $50</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
</body>
</html>
